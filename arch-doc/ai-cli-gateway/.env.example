# Обязательные переменные
AUTH_SECRET=your-strong-secret-here
POSTGRES_PASSWORD=your-postgres-password-here

# PostgreSQL (используется docker-compose сервисом postgres)
POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway

# URL базы данных (для сервиса ai-gateway внутри docker-compose)
DATABASE_URL=postgresql+asyncpg://ai_gateway:your-postgres-password-here@postgres:5432/ai_gateway

# Опциональные
WORKSPACE_DIR=/workspace
DEFAULT_TIMEOUT_SECONDS=300
AGENT_POOL_SIZE=4
SKILL_ROOT_DIR=/app/skills
